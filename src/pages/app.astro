---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { site } from '../data/site';
---

<BaseLayout page="app">
  <section class="page-hero section-pad"><div class="shell">
    <SectionIntro eyebrow="AVAILABLE ON THE APP STORE" title="Create subtitles on your iPhone or iPad." description="Video Transcriber: Subtitles transcribes spoken video, translates subtitles, lets you edit text and timing, and exports SRT files or finished captioned videos." />
    <a class="button" href={site.appPath}>View on the App Store <span aria-hidden="true">↗</span></a>
  </div></section>
  <section class="privacy-note section-pad"><div class="shell privacy-note-inner"><span class="lock-shape" aria-hidden="true">⌁</span><div><p>Choose Private On-Device transcription or optional High Accuracy Cloud transcription. Cloud mode uploads only an audio copy; your original video stays on your device.</p></div></div></section>
</BaseLayout>
